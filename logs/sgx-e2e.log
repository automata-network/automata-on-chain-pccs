help: wrap modifier logic to reduce code size
   |
36 ~     modifier collectFee() {
37 +         _collectFee();
38 +         _;
39 +     }
40 + 
41 +     function _collectFee() internal {
42 +         uint256 txFee;
43 +         if (_feeBP > 0) {
44 +             uint256 gasBefore = gasleft();
45 +             _;
46 +             uint256 gasAfter = gasleft();
47 +             txFee = ((gasBefore - gasAfter) * tx.gasprice * _feeBP) / MAX_BP;
48 +             if (msg.value < txFee) {
49 +                 revert Insufficient_Funds();
50 +             }
51 +         } else {
52 +             _;
53 +         }
54 +         if (msg.value > 0) {
55 +             uint256 excess = msg.value - txFee;
56 +             if (excess > 0) {
57 +                 // refund the sender, rather than the caller
58 +                 // @dev may fail subsequent call(s), if the caller were a contract
59 +                 // that might need to make subsequent calls requiring ETh transfers
60 +                 _refund(tx.origin, excess);
61 +             }
62 +         }
63 +     }
   |
   = help: https://book.getfoundry.sh/reference/forge/forge-lint#unwrapped-modifier-logic

