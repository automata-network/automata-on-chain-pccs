note[unwrapped-modifier-logic]: wrap modifier logic to reduce code size
  --> contracts/bases/FeeManagerBase.sol:36:5
   |
36 | /     modifier collectFee() {
37 | |         uint256 txFee;
38 | |         if (_feeBP > 0) {
39 | |             uint256 gasBefore = gasleft();
...  |
60 | |     }
   | |_____^
